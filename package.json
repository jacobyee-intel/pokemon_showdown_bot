{
  "name": "pokemon-showdown-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Simulator scaffold for a Gen 9 Pokemon Showdown self-play RL bot.",
  "engines": {
    "node": ">=22.14.0",
    "npm": ">=10.9.2"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "verify:showdown": "npm run build && node simulator/dist/verification/verify-showdown.js",
    "verify:seeded-battle": "npm run build && node simulator/dist/verification/verify-seeded-battle.js",
    "verify:scripted-error": "npm run build && node simulator/dist/verification/verify-scripted-error.js",
    "verify:battle-session": "npm run build && node simulator/dist/verification/verify-battle-session.js",
    "fixtures:capture": "npm run build && node simulator/dist/fixtures/capture-fixtures.js",
    "fixtures:verify": "npm run build && node simulator/dist/fixtures/verify-fixtures.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "pokemon-showdown": "0.11.11"
  }
}
